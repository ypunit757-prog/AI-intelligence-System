APP_ENV=development
# Postgres (default): postgresql+asyncpg://postgres:postgres@localhost:5432/aiknowledge
# MySQL: mysql+asyncmy://root:yourpassword@localhost:3306/aiknowledge
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aiknowledge
# MySQL managed providers that require TLS (PlanetScale, most cloud MySQL): set true
DATABASE_SSL_REQUIRE=false
VECTOR_STORE=faiss
# Free cloud option: LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-20b (get a free key at console.groq.com/keys)
# Note: Groq's llama-3.1-8b-instant / llama-3.3-70b-versatile are deprecated, shutting down 08/16/2026 — do not use those IDs.
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIMILARITY_THRESHOLD=0.2
RERANKER_MODEL=
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOCAL_STORAGE_DIR=./data/uploads
FAISS_INDEX_DIR=./data/faiss
REDIS_URL=redis://localhost:6379/0